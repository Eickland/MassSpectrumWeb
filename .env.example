# Скопируйте в .env и задайте свои значения. Файл .env не коммитьте.

# Ключ для загрузки результатов скриптом upload_results.py (заголовок X-API-Key).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Логин и пароль на весь веб-интерфейс (HTTP Basic). Пустой пароль — интерфейс открыт всем,
# на арендованном сервере так оставлять нельзя.
WEB_USER=lab
WEB_PASSWORD=

# Порт на хосте
PORT=8080

# Необязательно: другая БД (PostgreSQL) вместо SQLite в ./data
# DATABASE_URL=postgresql+psycopg://msweb:пароль@db:5432/msweb
# Предельный размер одной загрузки, МБ
MAX_UPLOAD_MB=200
